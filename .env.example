APP_NAME=Hotel PMS API
ENVIRONMENT=development
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_ENABLED=true
CORS_ORIGINS=["http://localhost:5173"]
# Solo para docker-compose (Coolify)
POSTGRES_DB=hotel_pms
POSTGRES_USER=hotel
POSTGRES_PASSWORD=
# SQLite para desarrollo; formato PostgreSQL para producción
DATABASE_URL=sqlite:///./hotel_pms.db
# postgresql+psycopg://usuario:clave@host:5432/base
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_NOMBRE=
SEED_ADMIN_PASSWORD=
SEED_RECEPCION_EMAIL=
SEED_RECEPCION_USERNAME=
SEED_RECEPCION_NOMBRE=
SEED_RECEPCION_PASSWORD=