APP_NAME=Hotel PMS API
ENVIRONMENT=development
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_ENABLED=true
CORS_ORIGINS=["http://localhost:5173"]
# Opcional: regex adicional de origenes permitidos. En desarrollo, si no se
# define, se admite cualquier puerto de localhost/127.0.0.1 para Flutter Web.
# En produccion requiere valor explicito por seguridad.
# CORS_ORIGIN_REGEX=
# Solo para docker-compose (Coolify)
POSTGRES_DB=hotel_pms
POSTGRES_USER=hotel
POSTGRES_PASSWORD=
# SQLite para desarrollo local.
DATABASE_URL=sqlite:///./hotel_pms.db

# Supabase (produccion). Conexion directa (recomendada para migraciones):
#   DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@db.<REF>.supabase.co:5432/postgres
# Supabase session pooler (puerto 5432, IPv4; usuario con sufijo de proyecto):
#   DATABASE_URL=postgresql+psycopg://postgres.<REF>:<PASSWORD>@aws-0-us-west-2.pooler.supabase.com:5432/postgres
# Si la contrasena tiene caracteres especiales, codificala (percent-encoding),
# p. ej. con: python -c "from urllib.parse import quote; print(quote('CLAVE', safe=''))"
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_NOMBRE=
SEED_ADMIN_PASSWORD=
SEED_RECEPCION_EMAIL=
SEED_RECEPCION_USERNAME=
SEED_RECEPCION_NOMBRE=
SEED_RECEPCION_PASSWORD=