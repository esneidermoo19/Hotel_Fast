{
  "openapi": "3.1.0",
  "info": {
    "title": "Hotel PMS API",
    "description": "\nAPI del PMS del hotel.\n\nAutenticacion por token JWT: usa `POST /api/auth/login` y pega el token en el boton\n**Authorize**. Los endpoints de escritura de habitaciones requieren rol `ADMIN`.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Iniciar sesion",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Consultar la sesion actual",
        "operationId": "obtenerSesion",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioRead"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Cerrar sesion",
        "operationId": "cerrarSesion",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/habitaciones": {
      "get": {
        "tags": [
          "habitaciones"
        ],
        "summary": "Listar habitaciones",
        "operationId": "listarHabitaciones",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Pagina solicitada, empezando en 1",
              "default": 1,
              "title": "Pagina"
            },
            "description": "Pagina solicitada, empezando en 1"
          },
          {
            "name": "tamano",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Cantidad de elementos por pagina",
              "default": 20,
              "title": "Tamano"
            },
            "description": "Cantidad de elementos por pagina"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pagina_HabitacionRead_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "habitaciones"
        ],
        "summary": "Crear una habitacion",
        "operationId": "crearHabitacion",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabitacionCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitacionRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/habitaciones/{habitacion_id}": {
      "get": {
        "tags": [
          "habitaciones"
        ],
        "summary": "Obtener una habitacion",
        "operationId": "obtenerHabitacion",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "habitacion_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Habitacion Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitacionRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "habitaciones"
        ],
        "summary": "Actualizar una habitacion",
        "operationId": "actualizarHabitacion",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "habitacion_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Habitacion Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabitacionUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitacionRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "habitaciones"
        ],
        "summary": "Eliminar una habitacion",
        "operationId": "eliminarHabitacion",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "habitacion_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Habitacion Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/habitaciones/{habitacion_id}/estado": {
      "patch": {
        "tags": [
          "habitaciones"
        ],
        "summary": "Cambiar el estado de una habitacion",
        "operationId": "actualizarEstadoHabitacion",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "habitacion_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Habitacion Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabitacionEstado"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitacionRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Estado del servicio",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EstadoHabitacion": {
        "type": "string",
        "enum": [
          "DISPONIBLE",
          "OCUPADA",
          "MANTENIMIENTO"
        ],
        "title": "EstadoHabitacion"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HabitacionCreate": {
        "properties": {
          "numero": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Numero"
          },
          "tipo": {
            "$ref": "#/components/schemas/TipoHabitacion"
          },
          "capacidad": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Capacidad"
          },
          "precioPorNoche": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,8}|(?=[\\d.]{1,11}0*$)\\d{0,8}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Preciopornoche"
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoHabitacion",
            "default": "DISPONIBLE"
          },
          "descripcion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Descripcion"
          }
        },
        "type": "object",
        "required": [
          "numero",
          "tipo",
          "capacidad",
          "precioPorNoche"
        ],
        "title": "HabitacionCreate"
      },
      "HabitacionEstado": {
        "properties": {
          "estado": {
            "$ref": "#/components/schemas/EstadoHabitacion"
          }
        },
        "type": "object",
        "required": [
          "estado"
        ],
        "title": "HabitacionEstado"
      },
      "HabitacionRead": {
        "properties": {
          "numero": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Numero"
          },
          "tipo": {
            "$ref": "#/components/schemas/TipoHabitacion"
          },
          "capacidad": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Capacidad"
          },
          "precioPorNoche": {
            "type": "number",
            "title": "Preciopornoche"
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoHabitacion",
            "default": "DISPONIBLE"
          },
          "descripcion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Descripcion"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedat"
          }
        },
        "type": "object",
        "required": [
          "numero",
          "tipo",
          "capacidad",
          "precioPorNoche",
          "id",
          "createdAt",
          "updatedAt"
        ],
        "title": "HabitacionRead"
      },
      "HabitacionUpdate": {
        "properties": {
          "numero": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Numero"
          },
          "tipo": {
            "$ref": "#/components/schemas/TipoHabitacion"
          },
          "capacidad": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Capacidad"
          },
          "precioPorNoche": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,8}|(?=[\\d.]{1,11}0*$)\\d{0,8}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Preciopornoche"
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoHabitacion",
            "default": "DISPONIBLE"
          },
          "descripcion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Descripcion"
          }
        },
        "type": "object",
        "required": [
          "numero",
          "tipo",
          "capacidad",
          "precioPorNoche"
        ],
        "title": "HabitacionUpdate"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "LoginResponse": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "tokenType": {
            "type": "string",
            "title": "Tokentype",
            "default": "bearer"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "role": {
            "$ref": "#/components/schemas/RolUsuario"
          }
        },
        "type": "object",
        "required": [
          "token",
          "id",
          "username",
          "email",
          "nombre",
          "role"
        ],
        "title": "LoginResponse"
      },
      "Pagina_HabitacionRead_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/HabitacionRead"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "pagina": {
            "type": "integer",
            "title": "Pagina"
          },
          "tamano": {
            "type": "integer",
            "title": "Tamano"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "pagina",
          "tamano"
        ],
        "title": "Pagina[HabitacionRead]"
      },
      "RolUsuario": {
        "type": "string",
        "enum": [
          "ADMIN",
          "RECEPCION"
        ],
        "title": "RolUsuario"
      },
      "TipoHabitacion": {
        "type": "string",
        "enum": [
          "SIMPLE",
          "DOBLE",
          "SUITE",
          "PRESIDENCIAL"
        ],
        "title": "TipoHabitacion"
      },
      "UsuarioRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "role": {
            "$ref": "#/components/schemas/RolUsuario"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "email",
          "nombre",
          "role"
        ],
        "title": "UsuarioRead"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Token JWT obtenido en /api/auth/login",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "Inicio de sesion, consulta de sesion y cierre de sesion."
    },
    {
      "name": "habitaciones",
      "description": "Catalogo de habitaciones y sus estados."
    },
    {
      "name": "health",
      "description": "Estado del servicio y de la base de datos."
    },
    {
      "name": "Huespedes",
      "description": "Gestion de huespedes."
    },
    {
      "name": "Reservas",
      "description": "Gestion de reservas."
    },
    {
      "name": "Pagos",
      "description": "Registro de pagos."
    },
    {
      "name": "Consumos",
      "description": "Consumos de los huespedes."
    },
    {
      "name": "Cuentas",
      "description": "Cuentas y cobros."
    },
    {
      "name": "Horarios",
      "description": "Horarios de check-in y check-out."
    },
    {
      "name": "Reportes",
      "description": "Reportes del hotel."
    },
    {
      "name": "Dashboard",
      "description": "Indicadores para el tablero."
    },
    {
      "name": "Usuarios",
      "description": "Gestion de usuarios."
    },
    {
      "name": "Catalogos",
      "description": "Catalogos auxiliares."
    },
    {
      "name": "Auditoria",
      "description": "Registro de auditoria."
    }
  ]
}
